{
  "id": "/",
  "name": "Ayo Sudoku!",
  "short_name": "Ayo Sudoku",
  "description": "A friendly, polished Sudoku game for the browser. Play Classic, Daily, Zen, Challenge and handcrafted packs offline. Learn techniques, chase stars, and keep your stats.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/#/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F2F2F7",
  "theme_color": "#F2F2F7",
  "categories": ["games", "education", "entertainment"],
  "author": {
    "name": "ffrizzy",
    "url": "https://ffrizzy.vercel.app/"
  },
  "developer": {
    "name": "ffrizzy",
    "url": "https://ffrizzy.vercel.app/"
  },
  "homepage_url": "https://ayosudoku.vercel.app/",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Daily puzzle",
      "short_name": "Daily",
      "description": "Play today's Daily Sudoku",
      "url": "/#/daily",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Puzzle packs",
      "short_name": "Packs",
      "description": "Play handcrafted puzzle packs",
      "url": "/#/packs",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Learn techniques",
      "short_name": "Learn",
      "description": "Learn Sudoku techniques with short lessons",
      "url": "/#/learn",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
