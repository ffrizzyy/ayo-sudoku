{
  "name": "ayo-sudoku",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "description": "A friendly, polished Sudoku game for the browser. Play offline, learn techniques, and chase stars.",
  "author": "ffrizzy (https://ffrizzy.vercel.app/)",
  "license": "MIT",
  "homepage": "https://ayosudoku.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffrizzyy/ayo-sudoku.git"
  },
  "bugs": {
    "url": "https://github.com/ffrizzyy/ayo-sudoku/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run && tsx scripts/check-i18n.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "gen:pack": "tsx scripts/gen-pack.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
